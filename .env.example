# Copy to .env and fill in. Do not commit .env.

# Render: Account Settings, API Keys. Used to create the test service.
RENDER_API_KEY=

# After the service is live. The key is MCP_API_KEY on the service Environment page.
BRAIN_URL=https://company-brain-xxxx.onrender.com
MCP_API_KEY=

# Optional. Leave empty until a Drive folder is shared with the service account.
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_JSON=

# ChatGPT sign-in. Leave OAUTH_ENABLED unset to keep these routes off.
# Render sets them. The password is generated per service.
# OAUTH_ENABLED=1
# OAUTH_BOOTSTRAP_EMAIL=owner@company-brain.local
# OAUTH_BOOTSTRAP_PASSWORD=
# Optional. Leave empty. The service uses the request host, which is the Render URL.
# PUBLIC_BASE_URL=https://company-brain-xxxx.onrender.com

# Optional. Empty means search only, no graph. The blueprint points these at OpenCode Go.
EXTRACTION_API_KEY=
EXTRACTION_BASE_URL=https://opencode.ai/inference/go/openai/v1
EXTRACTION_MODEL=deepseek-v4.1-flash

# Copy to .env and fill in. Do not commit .env.

# Render: Account Settings, API Keys. Used to create the test service.
RENDER_API_KEY=

# After the service is live. The key is MCP_API_KEY on the service Environment page.
BRAIN_URL=https://company-brain-xxxx.onrender.com
MCP_API_KEY=

# Optional. Leave empty until a Drive folder is shared with the service account.
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_JSON=
